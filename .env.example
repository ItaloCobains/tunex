# Default matches docker-compose (run: docker compose up -d)
DATABASE_URL=postgres://tunex:tunex@localhost:5434/tunex
REDIS_URL=redis://127.0.0.1:6379
PORT=8080
# Tunnel entry TTL in Redis (seconds); client heartbeats before expiry
TUNEX_TUNNEL_TTL_SECS=60
# Base domain for subdomain routing (dev: localhost; production: e.g. tunnex.com)
TUNEX_BASE_DOMAIN=localhost
# Scheme for public URL returned on register (http or https)
TUNEX_PUBLIC_SCHEME=http
# Gateway URL for tunex-client; read at compile time and compiled into the client binary
TUNEX_GATEWAY_URL=http://127.0.0.1:8080
